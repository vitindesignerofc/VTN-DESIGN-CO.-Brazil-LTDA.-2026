# Copie para o painel da Netlify: Site settings → Environment variables.
# NUNCA commite valores reais.
#
# --- Site público (orçamento/agendamento) ---
# Segredo interno usado para assinar as chamadas entre functions (Functions → Functions).
INTERNAL_HOOK_SECRET=gere-com-openssl-rand-hex-32

# --- Discord (notificação de orçamento novo) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/... (opcional)

# --- Newsletter (envio de novidades) ---
RESEND_API_KEY=re_... (opcional)
FROM_EMAIL=VTN <contato@seudominio.com> (remetente das novidades)

# --- Backend local (backend/server.js) ---
FRONTEND_URL=http://localhost:4173 (origem liberada no CORS)
# PORT=3001
#
# NOTA: o site NÃO tem painel administrativo nem contas de cliente.
# Nenhuma senha e nenhum CPF (documento) trafega ou fica guardado.
